<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime: needed to ask Finder to empty the Trash (without Full Disk Access). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Self-signed and ad-hoc builds have no Team ID, so library validation would refuse to
	     load the embedded Sparkle.framework. Developer ID builds use Spacebar.entitlements
	     and keep library validation on. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
