# Single source of truth for app identity. NEVER change BUNDLE_ID after the
# first public release: macOS ties Full Disk Access grants to it.
APP_NAME="Spacebar"
EXECUTABLE="Spacebar"
GITHUB_REPO="ovedaydin/spacebar"
BUNDLE_ID="io.github.ovedaydin.spacebar"
MIN_MACOS="13.0"
# Sparkle update signing (public half; the private key is a GitHub secret, never committed).
SPARKLE_PUBLIC_KEY="YuOPZcBt5cfyAbqQ6Tg3VmZflvuIYcQVSZq2Cu2ogWA="
# Each release publishes appcast.xml; "latest/download" always points at the newest one.
SPARKLE_FEED_URL="https://github.com/${GITHUB_REPO}/releases/latest/download/appcast.xml"
