        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca Spacebar'ın Çöp Sepeti'ne koyduğu öğeler. Çöp Sepeti'nizdeki diğer şeylere dokunulmaz."
          }
