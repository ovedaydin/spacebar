    "Your documents' folders, passwords, Mail, iCloud Drive, security keys and the apps you're running are never removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Dokumentordner, Passwörter, Mail, iCloud Drive, Sicherheitsschlüssel und laufende Apps werden nie entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca se eliminan las carpetas de tus documentos, las contraseñas, Mail, iCloud Drive, las claves de seguridad ni las apps que estás usando."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belge klasörleriniz, parolalarınız, Mail, iCloud Drive, güvenlik anahtarlarınız ve çalışan uygulamalarınız asla silinmez."
          }
        }
      }
    },
    "Your home folder" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Benutzerordner"
          }
