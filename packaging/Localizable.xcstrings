        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskiniz neredeyse dolu. macOS'in sorunsuz çalışması ve güncellemeleri yüklemesi için boş alan gerekir."
          }
        }
      }
    },
    "Your documents' folders, passwords, Mail, iCloud Drive, security keys and the apps you're running are never removed." : {
