    "Deletes %@ of caches. %@ rebuilds them when needed; quit it first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht %@ Caches. %@ erstellt sie bei Bedarf neu; beende die App vorher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Deletes %1$@ of caches. %2$@ rebuilds them when needed; quit it first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina %@ de cachés. %@ los vuelve a crear cuando hace falta; ciérrala antes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ önbellek silinir. %@ gerektiğinde bunları yeniden oluşturur; önce uygulamadan çıkın."
          }
        }
      }
    },
    "Dependencies and build output inside your projects (node_modules, target, build, Pods, .venv…). They're recreated by the project's install or build command. Projects untouched for 90 days are suggested." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abhängigkeiten und Build-Ausgaben in deinen Projekten (node_modules, target, build, Pods, .venv …). Sie werden vom Install- oder Build-Befehl des Projekts neu erstellt. Projekte, die seit 90 Tagen unverändert sind, werden vorgeschlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dependencias y resultados de compilación dentro de tus proyectos (node_modules, target, build, Pods, .venv…). Se vuelven a crear con el comando de instalación o compilación del proyecto. Se sugieren los proyectos que no se han tocado en 90 días."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projelerinizin içindeki bağımlılıklar ve derleme çıktıları (node_modules, target, build, Pods, .venv…). Projenin yükleme veya derleme komutuyla yeniden oluşturulurlar. 90 gündür dokunulmamış projeler önerilir."
          }
        }
      }
    },
    "DerivedData, build products, simulator caches, and old device support files. The newest two device support versions per platform are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DerivedData, Build-Produkte, Simulator-Caches und alte Device-Support-Dateien. Die zwei neuesten Device-Support-Versionen pro Plattform werden behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DerivedData, productos de compilación, cachés de simuladores y archivos antiguos de soporte de dispositivos. Se conservan las dos versiones más recientes de soporte de dispositivos por plataforma."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DerivedData, derleme ürünleri, simülatör önbellekleri ve eski aygıt destek dosyaları. Her platform için en yeni iki aygıt destek sürümü saklanır."
          }
        }
      }
    },
