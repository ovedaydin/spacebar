    "Moved %lld photos (%@) to Recently Deleted in Photos. Restore them there within 30 days, or delete them there to free the space now." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Foto (%@) in „Zuletzt gelöscht“ in Fotos bewegt. Stelle es dort innerhalb von 30 Tagen wieder her oder lösche es dort, um den Speicher sofort freizugeben."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Fotos (%@) in „Zuletzt gelöscht“ in Fotos bewegt. Stelle sie dort innerhalb von 30 Tagen wieder her oder lösche sie dort, um den Speicher sofort freizugeben."
