    "The read-only system, recovery and the files for installing updates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das schreibgeschützte System, die Wiederherstellung und die Dateien zum Installieren von Updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
