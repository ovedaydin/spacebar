    "Each app with its data, caches and settings in your Library. Caches are rebuilt when needed, so clearing them is safe." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede App mit ihren Daten, Caches und Einstellungen in deiner Library. Caches werden bei Bedarf neu erstellt, daher ist das Leeren sicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada app con sus datos, cachés y ajustes en tu Biblioteca. Las cachés se vuelven a crear cuando hace falta, así que borrarlas es seguro."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her uygulama, Kitaplık'taki verileri, önbellekleri ve ayarlarıyla birlikte. Önbellekler gerektiğinde yeniden oluşturulur, bu yüzden temizlemek güvenlidir."
          }
        }
      }
    },
    "Each pattern needs some text, like *.dmg or Screenshot*. A lone * would match everything." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Muster braucht etwas Text, z. B. *.dmg oder Screenshot*. Ein einzelnes * würde auf alles passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada patrón necesita algo de texto, como *.dmg o Captura*. Un * solo coincidiría con todo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her desen biraz metin içermelidir; örneğin *.dmg veya Screenshot*. Tek başına * her şeyle eşleşir."
          }
        }
      }
    },
    "Each removal is recorded in ~/Library/Logs/Spacebar/operations.log." : {
      "localizations" : {
        "de" : {
