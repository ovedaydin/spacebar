    "Some items couldn't be read. Grant Full Disk Access for a complete total." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Objekte konnten nicht gelesen werden. Erteile Festplattenvollzugriff für eine vollständige Summe."
