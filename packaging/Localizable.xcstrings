          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos de apps creados con Product › Archive. Contienen los símbolos de depuración necesarios para leer los informes de fallos de las versiones publicadas, así que conserva los que aún mantengas."
          }
        },
        "tr" : {
          "stringUnit" : {
