    },
    "Moved %@ to the Trash, so that space isn't free yet. Delete Now permanently deletes just these items; nothing else in your Trash is touched." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in den Papierkorb gelegt, daher ist der Speicher noch nicht frei. „Jetzt löschen“ löscht nur diese Objekte endgültig; alles andere im Papierkorb bleibt unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han trasladado %@ a la Papelera, así que ese espacio aún no está libre. “Eliminar ahora” elimina permanentemente solo estos ítems; no se toca nada más de la Papelera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Çöp Sepeti'ne taşındı; bu nedenle bu alan henüz boşalmadı. Şimdi Sil yalnızca bu öğeleri kalıcı olarak siler; Çöp Sepeti'nizdeki başka hiçbir şeye dokunulmaz."
          }
        }
      }
    },
    "Moved %lld items (%@) back to where they were." : {
      "localizations" : {
