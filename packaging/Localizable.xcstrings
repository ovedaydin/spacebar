    "Items that might matter go to the Trash. Put Back (⌥⌘Z) returns everything from your last clean." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte, die wichtig sein könnten, kommen in den Papierkorb. „Zurücklegen“ (⌥⌘Z) stellt alles aus deiner letzten Bereinigung wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ítems que podrían importar van a la Papelera. Devolver (⌥⌘Z) restaura todo lo de tu última limpieza."
          }
