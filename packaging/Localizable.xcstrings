    "System logs and crash reports. macOS deletes old ones on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemprotokolle und Absturzberichte. macOS löscht alte selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros del sistema e informes de fallos. macOS elimina los antiguos por sí solo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem günlükleri ve çökme raporları. macOS eskilerini kendisi siler."
          }
        }
      }
    },
    "System-wide app support" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
