          }
        }
      }
    },
    "Apps rebuild these. Items of running apps are skipped." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps erstellen diese neu. Objekte laufender Apps werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps los regeneran. Se omiten los ítems de las apps en ejecución."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar bunları yeniden oluşturur. Çalışan uygulamaların öğeleri atlanır."
          }
        }
      }
    },
    "Apps that come with macOS can't be removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit macOS gelieferte Apps können nicht entfernt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps incluidas con macOS no se pueden eliminar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ile gelen uygulamalar silinemez."
          }
        }
      }
    },
    "Apps' temporary files and caches outside your home folder. Restarting your Mac clears many of them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temporäre Dateien und Caches von Apps außerhalb deines Benutzerordners. Ein Neustart deines Mac löscht viele davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos temporales y cachés de apps fuera de tu carpeta de inicio. Al reiniciar el Mac, se borran muchos de ellos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamaların ev klasörünüz dışındaki geçici dosyaları ve önbellekleri. Mac'inizi yeniden başlatmak bunların çoğunu temizler."
          }
        }
      }
    },
    "Archives & disk images" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archive & Images"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
